# ==============================
# Xibo Media Sync - Configuration
# Location: main/scripts/.env
# ==============================

# ---- Xibo CMS ----
# Your Xibo CMS base URL on the hotspot network.
CMS_BASE_URL=http://localhost

# If you use HTTPS with valid certificates, you can set this to true.
CMS_VERIFY_TLS=false

# HTTP timeout (seconds) for API calls
CMS_TIMEOUT_SECONDS=30


# ---- API Auth ----
# none  -> do not send any Authorization header (works only if API auth is disabled)
# oauth -> uses OAuth2 Client Credentials against /api/authorize/access_token
AUTH_MODE=oauth

# OAuth application credentials (Administration > Applications in Xibo CMS)
# WARNING: stored in plain text.
CMS_CLIENT_ID=client_id_here
CMS_CLIENT_SECRET=client_secret_here


# ---- Sync phases and downloaded media ----
SYNC_MODE=full
SHAREPOINT_MEDIA_DIR=../media
CALENDAR_IMAGE_DIR=../calendar_images

# ---- Microsoft Graph (required for full/download modes) ----
# The Entra ID app requires Calendars.Read and Sites.Read.All application permissions with admin consent.
GRAPH_TENANT_ID=tenant_id_here
GRAPH_CLIENT_ID=client_id_here
GRAPH_CLIENT_SECRET=client_secret_here
GRAPH_SHAREPOINT_SITE_ID=site_id_here
GRAPH_SHAREPOINT_FOLDER=test_images
GRAPH_CALENDAR_USER_ID=calendar-user@example.com
GRAPH_CALENDAR_DAYS_AHEAD=14
GRAPH_CALENDAR_KEEP_SNAPSHOTS=10
GRAPH_TIMEOUT_SECONDS=30
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Required to be a directory in full/download mode; upload mode also accepts one JSON file.
# Relative paths are resolved from scripts/.
CALENDAR_JSON_PATH=C:\Users\office_calendar
# Xibo DataSet to replace with the latest calendar snapshot.
CALENDAR_DATASET_NAME=office_calendar_events
CALENDAR_DATASET_CODE=
# Include cancelled events in the uploaded snapshot.
CALENDAR_UPLOAD_CANCELLED_EVENTS=false
CALENDAR_EVENT_RETENTION_DAYS=30


# ---- Calendar HTML packages ----
# Enable calendar HTML package generation and upload.
CALENDAR_ENABLE_HTML=false

# Views to generate (comma-separated). Valid values are view names from scripts/templates/calendar/views/*.json
CALENDAR_HTML_VIEWS=today,this_week,next_2_weeks

# Optional: template directory containing template.html and views/*.json configs.
# Default: templates/calendar (relative to scripts/)
# CALENDAR_TEMPLATE_DIR=templates/calendar

# Auto-publish layouts after each package upload.
CALENDAR_AUTO_PUBLISH=true

# IANA timezone used for event filtering and display labels (default: Europe/Berlin).
# Daylight saving transitions are handled automatically by the IANA timezone database.
# Example: Europe/Berlin (handles CEST/CET automatically), Europe/Amsterdam, UTC
CALENDAR_TIMEZONE=Europe/Berlin

# Delete local calendar packages older than this many days.
CALENDAR_PACKAGE_RETENTION_DAYS=30

# File extensions to consider as media.
MEDIA_EXTENSIONS=.jpg,.jpeg,.png,.mp4

# Compare mode:
# filename -> compares local filename vs Xibo media name
# hash     -> compares sha256 hashes stored as tags in Xibo (requires the script to have uploaded/tagged the files before)
COMPARE_MODE=filename


# ---- Safety scope (recommended) ----
# Tag used to mark media managed by this sync script.
MANAGED_TAG=xibo-sync

# Delete only layouts carrying xibo-sync-media:<mediaId> when managed media is deleted.
# Safe default: disabled. A locked layout is released only when its draft has this exact tag;
# otherwise the media is retained for an operator-assisted retry.
DELETE_LAYOUT_WITH_MEDIA=false

# Only delete remote media that has MANAGED_TAG.
# Strongly recommended to prevent deleting unrelated CMS library items.
ONLY_DELETE_MANAGED_TAG=true

# Optional: restrict sync to a CMS folder ID (leave empty to ignore)
MANAGED_FOLDER_ID=


# ---- Behavior ----
# Upload new local files
UPLOAD_NEW_LOCAL=true

# Delete remote files that are missing locally
# This will also be asked at runtime (you can override per run).
DELETE_REMOTE_NOT_LOCAL=true

# Dry run -> do not upload/delete, only show what would happen
DRY_RUN=false


# ---- Player refresh ----
# Optional: trigger Collect Now after changes.
# If empty, refresh is skipped.
DISPLAY_GROUP_ID=
TRIGGER_COLLECTNOW_ON_CHANGES=true

# ---- Layout / Display workflow ----
# If enabled, the sync script can create a simple full-screen layout for uploaded media,
# publish it and assign it to a display group. Layout publication is always performed after
# background editing and again after tagging, so the final CMS checkout is released before
# assignment or immediate show. Useful for immediately showing newly uploaded media on displays.
CREATE_LAYOUT_PER_UPLOAD=true
ASSIGN_LAYOUT_ON_CHANGE=true
PUBLISH_ON_CHANGE=true
IMMEDIATE_SHOW_ON_CHANGE=false


# ---- Hash tagging ----
HASH_TAG_PREFIX=sha256:


# ---- Upload ----
# Multipart field name for upload. Some versions differ; script tries fallbacks automatically.
XIBO_UPLOAD_FIELD=files


# ---- Logging ----
LOG_LEVEL=INFO
# Optional: write logs to a file (relative to scripts/). Leave empty to disable.
LOG_FILE=logs/sync_xibo.log
