CMS_BASE_URL=http://cms-web
CMS_VERIFY_TLS=false
CMS_TIMEOUT_SECONDS=30
CMS_CLIENT_ID=dedicated-calendar-render-client-id
CMS_CLIENT_SECRET=dedicated-calendar-render-client-secret
CALENDAR_DATASET_NAME=office_calendar_events
CALENDAR_DATASET_CODE=
CALENDAR_HTML_VIEWS=today,this_week,next_2_weeks
CALENDAR_TEMPLATE_DIR=/app/templates/calendar
CALENDAR_TIMEZONE=Europe/Berlin
CALENDAR_EVENT_RETENTION_DAYS=30
CALENDAR_RENDER_OUTPUT_DIR=/tmp/calendar-render
MANAGED_TAG=xibo-sync
MANAGED_FOLDER_ID=
CREATE_LAYOUT_PER_UPLOAD=false
ASSIGN_LAYOUT_ON_CHANGE=false
IMMEDIATE_SHOW_ON_CHANGE=false
DISPLAY_GROUP_ID=
TRIGGER_COLLECTNOW_ON_CHANGES=true
XIBO_UPLOAD_FIELD=files
CALENDAR_RENDER_SCHEDULE_SECONDS=86400